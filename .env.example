CONDUUT_ENVIRONMENT=development

# Conduut-managed LLM providers. Configure only the providers used by the
# selected profile; never commit real values.
CONDUUT_MODEL_PROFILE=deepseek
CONDUUT_ANTHROPIC_API_KEY=
CONDUUT_GOOGLE_API_KEY=
CONDUUT_OPENAI_API_KEY=
CONDUUT_OPENROUTER_API_KEY=
CONDUUT_DEEPSEEK_API_KEY=

# Local shared n8n development instance.
CONDUUT_DEV_SHARED_N8N_API_KEY=replace-with-local-shared-dev-n8n-api-key
CONDUUT_N8N_VERSION=1.121.3
CONDUUT_N8N_URL=http://localhost:6180
CONDUUT_WORKFLOW_TIMEZONE=Europe/Istanbul
CONDUUT_FIREBASE_CREDENTIALS_MODE=auto
CONDUUT_FIREBASE_PROJECT_ID=
CONDUUT_FIREBASE_SERVICE_ACCOUNT_PATH=

# Server-only web BFF settings live in apps/web/.env.example.

# BYO n8n V1 placeholders. The backend still owns production-mode enforcement.
CONDUUT_N8N_PROVIDER_MODE=shared_dev
# shared_dev/tests: memory; local customer_owned: encrypted_file;
# production customer_owned: google_secret_manager.
CONDUUT_N8N_SECRET_MANAGER_BACKEND=memory
# encrypted_file defaults to apps/agent/.local/n8n-secrets.json. Set
# CONDUUT_N8N_LOCAL_SECRET_STORE_PATH only when an explicit local path is needed.
CONDUUT_N8N_SECRET_MANAGER_PROJECT_ID=
CONDUUT_N8N_SECRET_MANAGER_LOCATION=
CONDUUT_N8N_SECRET_MANAGER_SECRET_PREFIX=
CONDUUT_N8N_MIGRATION_MODE=off
CONDUUT_N8N_MIGRATION_MANIFEST_PATH=

# Optional Google OAuth broker. Generate a fresh Fernet key for local use and
# keep it only in .env or an approved secret manager.
CONDUUT_PUBLIC_WEB_URL=http://localhost:3000
CONDUUT_GOOGLE_OAUTH_CLIENT_ID=
CONDUUT_GOOGLE_OAUTH_CLIENT_SECRET=
CONDUUT_CONNECTION_ENCRYPTION_KEY=
CONDUUT_OAUTH_STATE_TTL_SECONDS=600
