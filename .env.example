CONDUUT_DEV_SHARED_N8N_API_KEY=replace-with-local-shared-dev-n8n-api-key

# BYO n8n V1 placeholders. The backend still owns production-mode enforcement.
CONDUUT_N8N_PROVIDER_MODE=shared_dev
# shared_dev/tests: memory; local customer_owned: encrypted_file;
# production customer_owned: google_secret_manager.
CONDUUT_N8N_SECRET_MANAGER_BACKEND=memory
# encrypted_file defaults to apps/agent/.local/n8n-secrets.json. Set
# CONDUUT_N8N_LOCAL_SECRET_STORE_PATH only when an explicit local path is needed.
CONDUUT_N8N_SECRET_MANAGER_PROJECT_ID=
CONDUUT_N8N_SECRET_MANAGER_SECRET_PREFIX=
CONDUUT_N8N_MIGRATION_MODE=off
CONDUUT_N8N_MIGRATION_MANIFEST_PATH=
